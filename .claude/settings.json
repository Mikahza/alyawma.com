{
    "permissions": {
        "deny": [
            "Bash(git commit)",
            "Bash(git commit *)",
            "Bash(git push)",
            "Bash(git push *)",
            "Read(./.env)",
            "Read(./.env.backup)",
            "Read(./.env.local)",
            "Read(./.env.production)",
            "Read(./.env.testing)",
            "Edit(./.env)",
            "Edit(./.env.backup)",
            "Edit(./.env.local)",
            "Edit(./.env.production)",
            "Edit(./.env.testing)",
            "Write(./.env)",
            "Write(./.env.backup)",
            "Write(./.env.local)",
            "Write(./.env.production)",
            "Write(./.env.testing)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".claude/hooks/guard-bash.sh",
                        "timeout": 10,
                        "statusMessage": "Checking the command against the repository guardrails"
                    }
                ]
            }
        ]
    }
}
