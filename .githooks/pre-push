#!/usr/bin/env bash
#
# Runs exactly what the CI runs, so a push that passes here is a pipeline that
# passes there.
#
# Bypass with `git push --no-verify`.

ZERO="0000000000000000000000000000000000000000"

# A push that only deletes remote branches has nothing to verify.
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" != "$ZERO" ] && has_content=1
done
[ "$has_content" -eq 0 ] && exit 0

printf 'pre-push: running composer ci:check\n\n'

if ! composer ci:check; then
    RED=$(printf '\033[0;31m')
    RESET=$(printf '\033[0m')
    printf '\n%spre-push: the CI checks fail. Pushing would open a red pull request.%s\n' "$RED" "$RESET" >&2
    exit 1
fi

exit 0
